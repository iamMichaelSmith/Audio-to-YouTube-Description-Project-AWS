# AWS
AWS_REGION=us-east-1

# Lambda/runtime wiring
TRANSCRIPT_LAMBDA_NAME=TranscriptAudioFunction
DESCRIPTION_LAMBDA_NAME=GenerateYoutubeDescriptionFunction

# Storage / I/O
INPUT_BUCKET=replace-me-input-bucket
OUTPUT_BUCKET=replace-me-output-bucket
TRANSCRIPT_PREFIX=transcripts/
DESCRIPTION_PREFIX=descriptions/

# AI provider settings (examples)
OPENAI_MODEL=gpt-5.1
OPENAI_API_KEY=replace-me

# Optional app/runtime flags
LOG_LEVEL=INFO
